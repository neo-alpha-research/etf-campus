#!/bin/sh
echo "🛡️ [Pre-Push Hook] Running pre-push verification (Secrets + Lint + TypeScript + Workers + Pipeline Linter)..."

echo "1/4 Checking code style & JSX syntax (ESLint)..."
npm run lint --silent
if [ $? -ne 0 ]; then
  echo "❌ [Pre-Push Hook] ESLint failed! Fix lint errors before pushing." >&2
  exit 1
fi

echo "2/4 Checking TypeScript types (tsconfig.ci.json)..."
npx tsc --noEmit -p tsconfig.ci.json
if [ $? -ne 0 ]; then
  echo "❌ [Pre-Push Hook] TypeScript typecheck failed! Push blocked to prevent breaking CI." >&2
  exit 1
fi

echo "3/4 Checking active Cloudflare Workers typechecks..."
npm --workspace=workers/market-briefing-publisher run typecheck --silent && \
npm --workspace=workers/market-briefing-distributor run typecheck --silent && \
npm --workspace=workers/community-maintenance run typecheck --silent
if [ $? -ne 0 ]; then
  echo "❌ [Pre-Push Hook] Workers typecheck failed! Push blocked to prevent breaking CI." >&2
  exit 1
fi

echo "4/4 Checking Pipeline Integrity & Failure Modes Linter (FM-001 ~ FM-013) & Unit Tests..."
python scripts/lint_pipeline.py && \
python -m unittest scripts/tests/test_lint_pipeline.py && \
python -m unittest scripts/tests/test_check_pages_deployment.py
if [ $? -ne 0 ]; then
  echo "❌ [Pre-Push Hook] Pipeline Linter / Gate tests failed! Push blocked." >&2
  exit 1
fi

echo "✅ [Pre-Push Hook] All pre-push checks passed successfully."
exit 0
