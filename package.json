{
  "name": "etf-campus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "osmu:download": "gh run download -n OSMU_Archive --dir OSMU_Archive",
    "dev": "next dev",
    "preview:local": "powershell -Command \"Start-Process 'C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe' -ArgumentList '--app=http://localhost:3000/?app=1 --window-size=412,915 --user-data-dir=\\\"$env:LOCALAPPDATA\\Temp\\etf_campus_app_profile\\\"'\"",
    "preview:app": "powershell -Command \"Start-Process 'C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe' -ArgumentList '--app=https://etf-campus.pages.dev/?app=1 --window-size=412,915 --user-data-dir=\\\"$env:LOCALAPPDATA\\Temp\\etf_campus_app_profile\\\"'\"",
    "prebuild": "node -e \"const fs=require('fs'); fs.mkdirSync('public/data', {recursive: true}); fs.copyFileSync('data/market_holidays.txt', 'public/data/market_holidays.txt');\" && npx tsx scripts/generate-screener-json.ts && node scripts/generate-style-og-images.mjs",
    "build": "next build",
    "check:release": "node scripts/check-release-readiness.mjs",
    "lint": "eslint .",
    "check:ci": "npm run lint && npx tsc --noEmit -p tsconfig.ci.json && npm test && npm --workspace=workers/market-briefing-publisher run typecheck && npm --workspace=workers/market-briefing-distributor run typecheck && npm --workspace=workers/community-maintenance run typecheck",
    "newsletter:snapshot": "node scripts/newsletter/create-weekly-snapshot.mjs",
    "newsletter:build": "node scripts/newsletter/generate-weekly-newsletter.mjs",
    "verify:utf8": "node scripts/verify-utf8.mjs",
    "books:sync-covers": "node scripts/fetch-book-covers.mjs",
    "test": "npm run verify:utf8 && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/status-bar": "^8.0.3",
    "@next/third-parties": "^16.3.2",
    "@tanstack/react-virtual": "^3.14.9",
    "csv-parse": "^7.0.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.34.0",
    "next": "16.2.10",
    "pretendard": "1.3.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "swr": "^2.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.10",
    "gray-matter": "^4.0.3",
    "jsdom": "28.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "workspaces": [
    "workers/market-briefing-publisher",
    "workers/market-briefing-distributor",
    "workers/community-maintenance"
  ]
}