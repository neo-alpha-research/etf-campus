{
  "name": "ETF Campus - 5-Min Market Refresh Prober (07:50-09:10 KST)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "50,55 7 * * 2-6"
            },
            {
              "field": "cronExpression",
              "expression": "*/5 8 * * 2-6"
            },
            {
              "field": "cronExpression",
              "expression": "0,5,10 9 * * 2-6"
            }
          ]
        }
      },
      "id": "cron-trigger-5min-window",
      "name": "Cron (07:50-09:10 KST 5-Min Intervals)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.github.com/repos/neo-alpha-research/etf-campus/actions/workflows/daily-market.yml/runs?per_page=5",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            },
            {
              "name": "User-Agent",
              "value": "n8n-NHNCloud-WorkflowTrigger"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "github-check-runs",
      "name": "Check GitHub Workflow Runs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "github-pat-header",
          "name": "GitHub PAT Authorization (Bearer YOUR_TOKEN)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst runs = response.workflow_runs || [];\n\nconst now = new Date();\nconst kstFormatter = new Intl.DateTimeFormat('en-CA', {\n  timeZone: 'Asia/Seoul',\n  year: 'numeric',\n  month: '2-digit',\n  day: '2-digit',\n});\nconst todayKst = kstFormatter.format(now);\n\nlet alreadySucceededToday = false;\nlet lastSuccessTimeKst = null;\n\nfor (const r of runs) {\n  if (r.status === 'completed' && r.conclusion === 'success') {\n    const runDateKst = kstFormatter.format(new Date(r.created_at));\n    if (runDateKst === todayKst) {\n      // Full market data refresh takes >60s. Early guard skips finish in <25s.\n      const durationMs = new Date(r.updated_at).getTime() - new Date(r.run_started_at || r.created_at).getTime();\n      if (durationMs > 45000) {\n        alreadySucceededToday = true;\n        lastSuccessTimeKst = r.created_at;\n        break;\n      }\n    }\n  }\n}\n\nconst isRunningNow = runs.some(r => r.status === 'in_progress' || r.status === 'queued');\n\nconst shouldTrigger = !alreadySucceededToday && !isRunningNow;\nconst reason = alreadySucceededToday \n  ? `Already succeeded today (${todayKst}) at ${lastSuccessTimeKst}`\n  : (isRunningNow ? 'Workflow is currently in progress / queued' : `Ready to trigger refresh for ${todayKst}`);\n\nreturn [{\n  json: {\n    todayKst,\n    alreadySucceededToday,\n    isRunningNow,\n    shouldTrigger,\n    reason\n  }\n}];"
      },
      "id": "evaluate-execution-status",
      "name": "Evaluate Execution Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-should-trigger",
              "leftValue": "={{ $json.shouldTrigger }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-should-trigger",
      "name": "Should Trigger Daily Market?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        920,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.github.com/repos/neo-alpha-research/etf-campus/actions/workflows/daily-market.yml/dispatches",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            },
            {
              "name": "User-Agent",
              "value": "n8n-NHNCloud-WorkflowTrigger"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"ref\": \"main\"\n}",
        "options": {
          "response": {
            "response": {
              "neverError": false
            }
          }
        }
      },
      "id": "github-dispatch-request",
      "name": "Trigger GitHub Actions (daily-market.yml)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1180,
        220
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "github-pat-header",
          "name": "GitHub PAT Authorization (Bearer YOUR_TOKEN)"
        }
      }
    },
    {
      "parameters": {},
      "id": "skip-no-op",
      "name": "Skip (Already Done / Running)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1180,
        400
      ]
    }
  ],
  "connections": {
    "Cron (07:50-09:10 KST 5-Min Intervals)": {
      "main": [
        [
          {
            "node": "Check GitHub Workflow Runs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check GitHub Workflow Runs": {
      "main": [
        [
          {
            "node": "Evaluate Execution Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Evaluate Execution Status": {
      "main": [
        [
          {
            "node": "Should Trigger Daily Market?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Should Trigger Daily Market?": {
      "main": [
        [
          {
            "node": "Trigger GitHub Actions (daily-market.yml)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Skip (Already Done / Running)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Seoul"
  }
}
