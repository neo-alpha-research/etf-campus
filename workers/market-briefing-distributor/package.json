{
  "name": "etf-campus-market-briefing-distributor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "dev": "wrangler dev",
