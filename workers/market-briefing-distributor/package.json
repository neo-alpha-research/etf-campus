  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "dotenv": "^17.4.2",
    "nodemailer": "^9.0.6",
    "puppeteer": "^25.9.0",
    "sharp": "^0.35.4"
  }
}
